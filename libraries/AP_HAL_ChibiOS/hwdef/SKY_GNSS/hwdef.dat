# ============================================================================
# SKY_GNSS 主固件硬件定义文件
# Main Firmware Hardware Definition File for SKY_GNSS
# ============================================================================

# ============================================================================
# MCU配置 (MCU Configuration)
# ============================================================================
# MCU类型和具体型号
MCU STM32F4xx STM32F412Rx

# 时钟源: 外部16MHz无源晶振 (HSE; PLLSRC=HSE -> SYSCLK 100MHz)
OSCILLATOR_HZ 16000000

# 系统时钟频率设置
define CH_CFG_ST_FREQUENCY 1000000

# 使用定时器5
STM32_ST_USE_TIMER 5

# ============================================================================
# Flash和存储配置 (Flash and Storage Configuration)
# ============================================================================
# 假定512K闪存
FLASH_SIZE_KB 512

# 引导程序在64K处启动固件
FLASH_RESERVE_START_KB 64

# 在第2和第3页存储参数
STORAGE_FLASH_PAGE 2
define HAL_STORAGE_SIZE 8192

# ============================================================================
# 板子标识和固件类型 (Board ID and Firmware Type)
# ============================================================================
# 固件加载的板子ID
APJ_BOARD_ID 1100

# 设置为外设固件构建
env AP_PERIPH 1

# ============================================================================
# 串口配置 (Serial Port Configuration)
# ============================================================================
# 串口输出设置
STDOUT_SERIAL SD1
STDOUT_BAUDRATE 57600

# UART串口顺序 (SERIAL0=USART1调试, SERIAL3=USART2 GPS)
SERIAL_ORDER USART1 EMPTY EMPTY USART2

# USART1用于调试 (原PB6/PB7已改作I2C1磁力计, 调试口迁移至PA9/PA10)
PA9  USART1_TX USART1 NODMA
PA10 USART1_RX USART1 NODMA
define DEFAULT_SERIAL0_BAUD 57600

# USART2用于GPS (M9n: TX2=PA2, RX2=PA3)
PA2 USART2_TX USART2 NODMA
PA3 USART2_RX USART2 NODMA

# ============================================================================
# 调试接口 (Debug Interface)
# ============================================================================
# SWD调试接口
PA13 JTMS-SWDIO SWD
PA14 JTCK-SWCLK SWD

# ============================================================================
# I2C总线配置 (I2C Bus Configuration)
# ============================================================================
# I2C1: IIS2MDC磁力计 (SCL=PB6, SDA=PB7)
PB6 I2C1_SCL I2C1
PB7 I2C1_SDA I2C1

# I2C3: BMP581气压计 (SCL=PA8, SDA=PB4)
PB4 I2C3_SDA I2C3
PA8 I2C3_SCL I2C3

# I2C配置 (STM32_I2C_USE_I2Cx 由hwdef脚本按总线占用自动生成)
define HAL_USE_I2C TRUE
define HAL_I2C_CLEAR_ON_TIMEOUT 0
define HAL_I2C_INTERNAL_MASK 0

# I2C总线顺序 (索引0=I2C1磁力计, 索引1=I2C3气压计)
I2C_ORDER I2C1 I2C3

# ============================================================================
# 传感器配置 (Sensor Configuration)
# ============================================================================
# 磁力计: IIS2MDC, 位于I2C1 (总线索引0), 地址0x1E
# 注意: ROTATION_NONE为占位, 请按实际贴装方向调整(或在飞控端设置罗盘方向)
COMPASS IIS2MDC I2C:0:0x1E false ROTATION_NONE
define AP_COMPASS_IIS2MDC_ENABLED 1

# 气压计: BMP581, 位于I2C3 (总线索引1), 地址0x46 (SDO接地; 若接VDD改为0x47)
BARO BMP581 I2C:1:0x47
define AP_BARO_BMP581_ENABLED 1

# 允许无气压计初始化
define HAL_BARO_ALLOW_INIT_NO_BARO

# ============================================================================
# GPIO和外设引脚配置 (GPIO and Peripheral Pin Configuration)
# ============================================================================
# MCU运行指示LED (PB12, 低电平点亮; AP_Periph以1Hz心跳翻转该引脚)
PB12 LED OUTPUT LOW

# WS2812 RGB LED (8颗 WS2812-4020 菊花链, 数据线=PB0=TIM3_CH3, 经DMA1 Stream2驱动)
PB0 TIM3_CH3 TIM3 PWM(1)

# 蜂鸣器 (MLT-7525无源蜂鸣器, 谐振2700Hz, PB10=TIM2_CH3; 鸣叫频率由飞控经DroneCAN下发)
PB10 TIM2_CH3 TIM2 GPIO(77) LOW ALARM

# ============================================================================
# CAN总线配置 (CAN Bus Configuration)
# ============================================================================
# CAN总线引脚
PB8 CAN1_RX CAN1
PB9 CAN1_TX CAN1
# CAN1_SILENT (PB5): 硬件外部上拉(上电默认静默), 固件驱动为低=正常收发模式
PB5 GPIO_CAN1_SILENT OUTPUT PUSHPULL SPEED_LOW LOW

# CAN总线节点名称
define CAN_APP_NODE_NAME "org.ardupilot.sky_gnss"

# ============================================================================
# ADC配置 (ADC Configuration)
# ============================================================================
# 禁用ADC以节省资源
define HAL_USE_ADC FALSE
define STM32_ADC_USE_ADC1 FALSE
define HAL_DISABLE_ADC_DRIVER TRUE

# ============================================================================
# 系统优化配置 (System Optimization Configuration)
# ============================================================================
# 禁用GPIO中断
define HAL_NO_GPIO_IRQ

# 禁用RCIN线程以节省内存
define HAL_NO_RCIN_THREAD

# 禁用监视线程
define HAL_NO_MONITOR_THREAD

# 禁用其他功能以节省资源
define HAL_USE_RTC FALSE
define DISABLE_SERIAL_ESC_COMM TRUE
define DMA_RESERVE_SIZE 0
define HAL_DISABLE_LOOP_DELAY

# 设备线程栈大小
define HAL_DEVICE_THREAD_STACK 768

# 设置较小的参数表
define AP_PARAM_MAX_EMBEDDED_PARAM 256

# 仅启用单个磁力计以节省闪存空间
define HAL_COMPASS_MAX_SENSORS 1

# ============================================================================
# 外设功能启用 (Peripheral Function Enable)
# ============================================================================
# 启用GPS+磁罗盘+气压计功能
define AP_PERIPH_GPS_ENABLED 1
define AP_PERIPH_MAG_ENABLED 1
define AP_PERIPH_BARO_ENABLED 1

# GPS配置
define GPS_MAX_RATE_MS 200
define GPS_MAX_RECEIVERS 1
define GPS_MAX_INSTANCES 1
define HAL_PERIPH_GPS_PORT_DEFAULT 3

# 启用蜂鸣器（不使用通知库）
define AP_PERIPH_BUZZER_WITHOUT_NOTIFY_ENABLED 1

# 上电开机秀: 8颗RGB逐一蓝色点亮(每颗150ms), 同时播放一段递升大三和弦琶音
# (do-mi-sol-do, 末音为此谐振频率并延长), 全蓝保持300ms后全灭, 总时长约1.5秒;
# 注释HAL_PERIPH_BUZZER_SELF_TEST即整体关闭(音效+灯效). MLT-7525谐振点约2700Hz;
# 灯效结束后LED由飞控经DroneCAN LightsCommand接管(蓝闪=GPS未定位, 绿闪=已定位)
define HAL_PERIPH_BUZZER_SELF_TEST 2700

# 启用开机秀'蓝色逐一点亮+琶音'(见update_startup_show), 同时编译移除默认的启动彩虹效果;
# 注释本行则恢复update_rainbow()彩虹效果(该函数硬编码要求COUNT==8才会编译)
define HAL_PERIPH_STARTUP_SHOW 1

# 直接控制neopixel LED(without-notify路径), 8颗WS2812-4020菊花链
define HAL_PERIPH_NEOPIXEL_CHAN_WITHOUT_NOTIFY 0
define HAL_PERIPH_NEOPIXEL_COUNT_WITHOUT_NOTIFY 8

# 默认LED类型
define DEFAULT_NTF_LED_TYPES 455
